# Local-only IMF configuration.
# Copy to .env. Never commit or paste real values into chat, boards, or logs.

# Feishu live board (Docx collaborative document)
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_FOLDER_TOKEN=
FEISHU_CHAT_ID=

# DeepSeek API — Flash (high) and Pro (max) share one key
DEEPSEEK_PROVIDER=direct
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
FLASH_MODEL=deepseek-v4-flash
FLASH_REASONING=high
PRO_MODEL=deepseek-v4-pro
PRO_REASONING=max

# Optional SiliconFlow for the two DeepSeek operatives
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# Cursor CLI is preferred for Grok 4.6 high and GPT Luna max.
# If agent is missing, set CURSOR_API_BASE to an OpenAI-compatible endpoint.
CURSOR_API_KEY=
CURSOR_API_BASE=
CURSOR_GROK_MODEL=cursor-grok-4.6-high
CURSOR_LUNA_MODEL=gpt-5.6-luna-high
