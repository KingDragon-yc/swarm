# Local-only collaboration configuration.
# Copy to .env. Never commit or paste real values into chat or logs.

# Feishu Docx projection and optional group completion notification
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_DOCUMENT_ID=
FEISHU_FOLDER_TOKEN=
FEISHU_CHAT_ID=

# SiliconFlow shared provider
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# API workers: PROVIDER accepts direct or siliconflow.
DEEPSEEK_PROVIDER=direct
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

KIMI_PROVIDER=direct
KIMI_API_KEY=
KIMI_MODEL=
KIMI_BASE_URL=https://api.moonshot.cn/v1

GLM_PROVIDER=direct
GLM_API_KEY=
GLM_MODEL=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

QWEN_PROVIDER=direct
QWEN_API_KEY=
QWEN_MODEL=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Cursor workers. auto resolves a current vendor model from agent --list-models.
CURSOR_API_KEY=
CURSOR_CLAUDE_MODEL=auto
CURSOR_GEMINI_MODEL=auto
CURSOR_GROK_MODEL=auto
